<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.cm.user.mapper.UserInfoMapper">
    <select id="findById" resultType="com.cm.entity.User">
        select id,real_name,user_type from user where id = #{id}
    </select>
</mapper>